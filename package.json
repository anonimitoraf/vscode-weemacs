{
  "name": "weemacs",
  "displayName": "weemacs",
  "description": "Recreating my most-used emacs tools in vscode",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "publisher": "anonimitoraf",
  "repository": "https://github.com/anonimitoraf/vscode-weemacs.git",
  "contributes": {
    "commands": [
      {
        "command": "weemacs.searchProject",
        "title": "Weemacs: Search project"
      }
    ]
  },
  "scripts": {
    "package": "pnpm run compile && vsce package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.3.2",
    "eslint": "^9.23.0",
    "typescript": "^5.8.2"
  }
}
